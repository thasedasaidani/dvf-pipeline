# Source des fichiers DVF géolocalisés (Etalab)
DVF_BASE_URL=https://files.data.gouv.fr/geo-dvf/latest/csv/
# Dossier local des fichiers bruts
DVF_RAW_DIR=data/raw
# Dossier des tables nettoyées (Parquet)
DVF_PROCESSED_DIR=data/processed
# Mémoire allouée à Spark (baisser à 2g si la machine a peu de RAM)
SPARK_DRIVER_MEMORY=4g
